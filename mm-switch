#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f "$0")"
if [[ $# == 1 && "$1" != status && "$1" != recover && "$1" != password && "$1" != --version && "$1" != --help ]]; then
    exec python3 "$(dirname "$script")/switcher.py" switch "$1"
fi
exec python3 "$(dirname "$script")/switcher.py" "$@"
